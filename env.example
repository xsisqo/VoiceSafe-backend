# ===============================
# VoiceSafe Backend — ENV EXAMPLE
# ===============================

PORT=5000
NODE_ENV=production

# Public URLs
FRONTEND_URL=https://voicesafe-frontend.onrender.com
AI_URL=https://voicesafe-ai.onrender.com/analyze

# Upload / AI timeouts (optional for future use)
MAX_UPLOAD_MB=50
AI_TIMEOUT_MS=120000

# ===============================
# Queue (only if you use worker.js + BullMQ later)
# ===============================
REDIS_URL=rediss://:password@host:port
JOB_ATTEMPTS=2
JOB_BACKOFF_MS=2500
WORKER_CONCURRENCY=2

# ===============================
# Stripe (required only if you use payments)
# ===============================
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID=price_xxxxx

# Optional (future)
STRIPE_TRIAL_DAYS=7
STRIPE_BILLING_RETURN_URL=https://voicesafe-frontend.onrender.com