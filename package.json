{
  "name": "voicesafe-backend",
  "version": "3.0.0",
  "description": "VoiceSafe Enterprise Backend API (Async Jobs + Worker)",
  "main": "server.js",
  "type": "commonjs",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "prestart": "node -e \"console.log('Starting VoiceSafe Backend…')\"",
    "start": "node server.js",
    "start:worker": "node worker.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "dev:worker": "cross-env NODE_ENV=development nodemon worker.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "bullmq": "^5.12.10",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "stripe": "^16.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}